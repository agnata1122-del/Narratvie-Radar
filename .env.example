# 복사해서 .env로 쓴다. .env는 커밋하지 않는다.

# Anthropic API (분류·위키 생성). SDK가 직접 읽는다.
ANTHROPIC_API_KEY=

# 로컬 SQLite 경로
NR_DB_PATH=data/narrative_radar.db

# 전체 라이브 수집 스위치. 기본값은 꺼짐. docs/DATA_POLICY.md를 읽고 켠다.
NR_LIVE_COLLECTION_ENABLED=false

# 작성자 식별자 HMAC용 비밀값. 길고 무작위인 값을 쓰고 공유하지 않는다.
# 예: python -c "import secrets; print(secrets.token_hex(32))"
NR_AUTHOR_HASH_SALT=

# 분류 모델
NR_CLASSIFIER_MODEL=claude-haiku-5-5
