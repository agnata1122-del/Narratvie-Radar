        {"name": "label_causal", "label": "인과·방향", "options": [[1, "맞음"], [0, "틀림"], [null, "해당 없음"]]},
        {"name": "label_stance", "label": "태도", "options": [[1, "맞음"], [0, "틀림"], [null, "해당 없음"]]}
