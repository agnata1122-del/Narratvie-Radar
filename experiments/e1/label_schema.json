        {"name": "label_claims", "label": "주장", "options": [[1, "맞음"], [0, "틀림"], [null, "해당 없음"]], "gate": true},
        {"name": "label_stance", "label": "태도", "options": [[1, "맞음"], [0, "틀림"], [null, "해당 없음"]], "gate": true},
        {"name": "label_overall", "label": "전체", "options": [[1, "맞음"], [0, "틀림"]]}
      ],
      "note": "note"
    },
